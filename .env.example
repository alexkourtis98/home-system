# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for production
# Example: CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=

# Database Configuration
# For local development without MongoDB, leave empty to use MongoDB Memory Server
# For production, use a real MongoDB connection string
MONGODB_URI=

# JWT Configuration
# IMPORTANT: Change this to a strong random secret in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=dom1k0n-sup3r-s3cr3t-k3y-ch4ng3-1n-pr0duct10n-2024

# Admin Credentials (MVP Only)
# IMPORTANT: In production, implement proper user management system
# These credentials will be hashed using bcrypt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@home-system.com

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting (API routes only, not static files)
# Development: Use 1000 for comfortable local development
# Production: Use 100 for security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Session Configuration
SESSION_TIMEOUT=24h
REFRESH_TOKEN_EXPIRY=7d
